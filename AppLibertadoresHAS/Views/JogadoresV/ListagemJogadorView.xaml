<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppLibertadoresHAS.Views.JogadoresV.ListagemJogadorView"
             Title="ListagemJogadoresView">
    <VerticalStackLayout 
        Padding="10">

        <Label 
            Text="Jogadores"
            FontSize="26"
            FontAttributes="Bold"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <CollectionView ItemsSource="{Binding Jogadores}">

            <CollectionView.ItemTemplate>

                <DataTemplate>
                    <Border
                        Margin="5"
                        Padding="15">

                        <VerticalStackLayout Spacing="5">
                            <Label
                                Text="{Binding Nome}"
                                FontSize="20"
                                FontAttributes="20"/>

                            <Label
                            Text="{Binding Numero, StringFormat='Numero: {0}'}"
                            FontSize="16"/>

                            <Label
                            Text="{Binding Posicao.Nome, StringFormat='Posicao: {0}'}"/>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>

            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>